# Atlas Engine - Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=atlas-engine
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/atlas

# Authentication (OIDC / Keycloak)
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://keycloak:8080/realms/atlas
OIDC_CLIENT_ID=atlas-engine
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/callback
OIDC_SCOPES=openid profile email roles
SESSION_SECRET_KEY=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# CORS
CORS_ORIGINS=http://localhost:3000

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# GitHub (optional)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=